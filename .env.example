# ---- Brand ----
# The public product name on every user-facing surface: Telegram /start, the
# Mini App button, the README inside the delivered .zip, and Discord embeds.
# The repo, package and logs stay "WebMachine".
BRAND_NAME=FivePageBot

# ---- Server ----
PORT=8080
NODE_ENV=production
CORS_ORIGINS=https://your-miniapp.example.com

# ---- MongoDB (Atlas M0) ----
# The /webmachine path segment is the database name. Leave it out and Mongoose
# writes to a database called "test" without complaining.
# Percent-encode any special character in the password: @ is %40, # is %23.
MONGODB_URI=mongodb+srv://wmuser:password@cluster0.xxxxx.mongodb.net/webmachine?retryWrites=true&w=majority

# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Random string you invent; Telegram echoes it on every webhook call
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS base URL of this server (also serves the Mini App)
PUBLIC_BASE_URL=https://api.your-domain.com
MINI_APP_URL=https://api.your-domain.com

# Bot username without the @. Discord links here to sell the paid tiers,
# since Stars only exist on Telegram. Leave blank to render no upsell.
TELEGRAM_BOT_USERNAME=FivePageBot

# ---- Discord (FivePageBot) ----
# Free tier only: Discord has no arbitrary-amount invoice and no bot-callable
# refund, so checkout stays on Telegram. Leave DISCORD_ENABLED=false to run
# Telegram-only; nothing else here is read when it is off.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional. A test server id, so `npm run register:discord:dev` gives you
# commands that appear instantly instead of propagating globally for an hour.
DISCORD_DEV_GUILD_ID=
# Optional. Overrides BRAND_NAME on Discord only. Normally left blank.
DISCORD_BRAND_NAME=

# ---- Legal pages (served at /terms and /privacy) ----
LEGAL_ENTITY=NuroWorks
# Optional. Shown as the contact on both pages. Left blank, the pages say to
# contact you through the bot rather than publishing an address.
LEGAL_CONTACT_EMAIL=
LEGAL_UPDATED=2026-10-23

# ---- Pricing (Telegram Stars) ----
PRICE_SITE_STARS=1500
PRICE_FUNNEL_STARS=3800

# ---- Build limits ----
FREE_BUILDS_PER_DAY=1
MAX_PAGES_PER_BUILD=6
DAILY_USD_CAP=50
GENERATION_TIMEOUT_MS=180000
INITDATA_MAX_AGE_SECONDS=3600
# Set to "true" ONLY for local development; skips Telegram signature checks
ALLOW_DEV_AUTH=false

# ---- Ops ----
# Private channel id for sale / failure alerts. Optional.
OPS_CHANNEL_ID=
