{
  "name": "webmachine-backend",
  "version": "3.0.0",
  "description": "WebMachine - Telegram bot + Mini App that generates real multi-page websites and sales funnels with Claude, paid for in Telegram Stars.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
