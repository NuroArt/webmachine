    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "mongoose": "^8.9.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "mongodb-memory-server": "^11.3.0"
  },
